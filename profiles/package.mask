# Waywallen undergoes frequent changes upstream, and building it
# on Gentoo is very difficult, so I am no longer maintaining it.
# Removal on 2026-09-27.
dev-qt/qtgrpc
dev-libs/qml-material
media-plugins/waywallen-display
gui-apps/waywallen
media-gfx/open-wallpaper-engine

# Zakk <zakk@gentoozh.org> (2026-08-12)
# This legacy release is no longer updated. arm64 and loong users should use
# app-office/wps-office365-edu, which supports offline use.
=app-office/wps-office-11.1.0.11719-r2

# jinqiang zhang <peeweep@0x0.ee> (2026-08-09)
# gentoo-zh's virtual/dist-kernel is incompatible with ::gentoo's
# virtual/dist-kernel, only gentoo-zh's xanmod-kernel, gentoo-cjk-kernel
# and gentoo-cjk-kernel-bin use it.
# Manually unmask it if you need any of them.
virtual/dist-kernel

# jinqiang zhang <peeweep@0x0.ee> (2026-07-31)
