: ${AMULE_USER:=amule}
: ${AMULE_GROUP:=amule}
: ${AMULE_HOME:=/var/lib/amule}

command="/usr/bin/amuled"
command_args="${AMULED_OPTS}"
command_user="${AMULE_USER}:${AMULE_GROUP}"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
directory="${AMULE_HOME}"
retry="TERM/60/KILL/5"

description="aMule eD2k and Kademlia daemon"

depend() {
	need net
}

start_pre() {
	export HOME="${AMULE_HOME}"
}
