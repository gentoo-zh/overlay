src_unpack() {
	cargo_src_unpack
	local dep
	for dep in "${!ZBS_DEPENDENCIES[@]}"; do
		ezig fetch --global-cache-dir "${ZBS_ECLASS_DIR}" "${DISTDIR}/${dep}" > /dev/null
	done
}

src_configure() {
	local my_zbs_args=(
		--build-file "${S}/vendor/libghostty-vt/build.zig"
		-Demit-lib-vt -Dsimd=true -Dstrip=false
		-Dversion-string="$(<vendor/libghostty-vt/VERSION)"
		-Demit-xcframework=false
		--prefix /vt
	)
	zig_src_configure
	export LIBGHOSTTY_VT_LIB_DIR="${BUILD_DIR}/vt/$(get_libdir)"
	cargo_src_configure
}

src_compile() {
	zig_src_compile
	cargo_src_compile
}

src_test() {
	# Tests read ~/.config/herdr and inherit HERDR_* from a herdr pane, so
	# give them a clean HOME and env. nextest runs one process per test like
	# upstream CI; under libtest threads they clobber each other's XDG vars.
	local var
	for var in ${!HERDR_*}; do
		unset "${var}"
	done
	local test_home="${T}/test-home"
	mkdir -p "${test_home}" || die
	HOME="${test_home}" LC_ALL=C cargo_env cargo nextest run --locked --offline || die "tests failed"
}

src_install() {
	cargo_src_install
	einstalldocs
}
