From: Xiangzhe <xiangzhedev@gmail.com>
Date: Wed, 7 Oct 2026 01:24:17 +0800
Subject: [PATCH] fix: isolate overlay styles from pane content

Reset panel cells before painting so underlying text modifiers and underline colors cannot leak into menus and dialogs. Preserve each overlay's own styles and leave cells outside its bounds unchanged.

Add a regression that compares a menu over styled content with the same menu over an empty buffer, including selected-row highlighting.
---
 src/client/shell/overlays.rs             |  8 ++--
 src/client/shell/tests/chrome_context.rs | 48 ++++++++++++++++++++++++
 2 files changed, 53 insertions(+), 3 deletions(-)

diff --git a/src/client/shell/overlays.rs b/src/client/shell/overlays.rs
index f26cc6e4..6a81c717 100644
--- a/src/client/shell/overlays.rs
+++ b/src/client/shell/overlays.rs
@@ -227,11 +227,13 @@ fn panel(
     if a.width < 2 || a.height < 2 {
         return None;
     }
-    let background = Style::default().bg(bg).remove_modifier(Modifier::DIM);
-    let border = Style::default().fg(c).bg(bg).remove_modifier(Modifier::DIM);
+    let background = Style::default().bg(bg);
+    let border = Style::default().fg(c).bg(bg);
     for y in a.y..a.bottom() {
         for x in a.x..a.right() {
-            b[(x, y)].set_symbol(" ").set_style(background);
+            let cell = &mut b[(x, y)];
+            cell.reset();
+            cell.set_style(background);
         }
     }
     for x in a.x..a.right() {
diff --git a/src/client/shell/tests/chrome_context.rs b/src/client/shell/tests/chrome_context.rs
index 1e1d5fc3..f8f503ea 100644
--- a/src/client/shell/tests/chrome_context.rs
+++ b/src/client/shell/tests/chrome_context.rs
@@ -377,6 +377,54 @@ fn context_menus_capture_stable_targets_and_route_actions() {
     ));
 }
 
+#[test]
+fn context_menu_styles_are_independent_of_underlying_cells() {
+    use ratatui::buffer::Cell;
+    use ratatui::style::Color;
+
+    let palette = ClientShellConfig::from_config(&Config::default()).palette;
+    let menu = ClientContextMenuOverlay {
+        target: ClientContextMenuTarget::Pane {
+            pane_id: "pane_1".into(),
+            workspace_id: "ws_1".into(),
+            source_pane_id: None,
+            has_manual_label: false,
+            right_click_passthrough: false,
+        },
+        x: 4,
+        y: 2,
+        highlighted: 0,
+    };
+    let area = Rect::new(0, 0, 60, 16);
+    let mut clean = Buffer::empty(area);
+    let rendered = render::render_context_menu(&mut clean, &menu, &palette).expect("menu");
+    let mut underlying = Cell::default();
+    underlying.set_symbol("x").set_style(
+        Style::default()
+            .fg(Color::Red)
+            .bg(Color::Blue)
+            .underline_color(Color::Yellow)
+            .add_modifier(Modifier::all()),
+    );
+    let mut styled = Buffer::filled(area, underlying.clone());
+    render::render_context_menu(&mut styled, &menu, &palette).expect("menu over styled pane");
+
+    for y in area.y..area.bottom() {
+        for x in area.x..area.right() {
+            let expected = if rendered.area.contains((x, y).into()) {
+                &clean[(x, y)]
+            } else {
+                &underlying
+            };
+            assert_eq!(&styled[(x, y)], expected, "cell ({x}, {y})");
+        }
+    }
+    let selected = rendered.menu_rows[0].0;
+    assert_eq!(styled[(selected.x, selected.y)].modifier, Modifier::BOLD);
+    let normal = rendered.menu_rows[1].0;
+    assert_eq!(styled[(normal.x, normal.y)].modifier, Modifier::empty());
+}
+
