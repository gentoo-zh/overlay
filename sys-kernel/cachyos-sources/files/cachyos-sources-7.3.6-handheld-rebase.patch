From: Gentoo CachyOS overlay
Subject: [PATCH] rebase handheld patch on Linux 7.3.6

Linux 7.3.6 renames the dcn32_set_mcm_luts() dpp_base argument to dpp
(stable commit b19d10fb24aa) and builds btusb from btusb_main.c, so
retarget those two hunks; the changes themselves are unchanged.
Apply to temporary handheld.patch, not the kernel source.

Upstream: https://github.com/CachyOS/kernel-patches/blob/4360bfe17b51d3cb47c45848244ca989522df0cf/7.3/misc/0001-handheld.patch

--- a/handheld.patch
+++ b/handheld.patch
@@ -994,10 +994,10 @@
  MODULE_AUTHOR("Daniel Drake <drake@endlessm.com>");
  MODULE_DESCRIPTION("Bluetooth support for Realtek devices ver " VERSION);
  MODULE_VERSION(VERSION);
-diff --git a/drivers/bluetooth/btusb.c b/drivers/bluetooth/btusb.c
+diff --git a/drivers/bluetooth/btusb_main.c b/drivers/bluetooth/btusb_main.c
 index 109013b43956..1d70df790bb1 100644
---- a/drivers/bluetooth/btusb.c
-+++ b/drivers/bluetooth/btusb.c
+--- a/drivers/bluetooth/btusb_main.c
++++ b/drivers/bluetooth/btusb_main.c
 @@ -424,6 +424,8 @@ static const struct usb_device_id quirks_table[] = {
  						     BTUSB_WIDEBAND_SPEECH },
  	{ USB_DEVICE(0x2c7c, 0x0132), .driver_info = BTUSB_QCA_WCN6855 |
@@ -1847,15 +1847,15 @@
 @@ -506,10 +506,9 @@ bool dcn32_set_mcm_luts(
  		lut_params = &plane_state->cm.shaper_func.pwl;
  	else if (plane_state->cm.shaper_func.type == TF_TYPE_DISTRIBUTED_POINTS) {
- 		// TODO: dpp_base replace
+ 		// TODO: dpp replace
 -		rval = cm3_helper_translate_curve_to_hw_format(plane_state->ctx,
 -			&plane_state->cm.shaper_func,
--			&dpp_base->shaper_params,
+-			&dpp->shaper_params,
 -			true);
 +		rval = cm_helper_translate_curve_to_hw_format(plane_state->ctx,
 +						       &plane_state->cm.shaper_func,
-+						       &dpp_base->shaper_params, true);
- 		lut_params = rval ? &dpp_base->shaper_params : NULL;
++						       &dpp->shaper_params, true);
+ 		lut_params = rval ? &dpp->shaper_params : NULL;
  	}
  
 diff --git a/drivers/gpu/drm/amd/display/dc/link/link_detection.c b/drivers/gpu/drm/amd/display/dc/link/link_detection.c
