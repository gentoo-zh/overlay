-
-		prev_aff = prev;
-	}
-
 	if (sched_smt_active()) {
 		has_idle_core = test_idle_cores(target);
 
@@ -9057,9 +8980,6 @@ static int select_idle_sibling(struct task_struct *p, int prev, int target, int
 	if ((unsigned)i < nr_cpumask_bits)
