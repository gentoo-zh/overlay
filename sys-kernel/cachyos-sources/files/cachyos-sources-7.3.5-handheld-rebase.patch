From: Gentoo CachyOS overlay
Subject: [PATCH] rebase handheld Realtek contexts on Linux 7.3.5

Keep Linux 7.3.5's ASUS enum and Minisforum microphone fixups while
applying the unchanged AYANEO additions from the pinned handheld patch.
Apply to temporary handheld.patch, not the kernel source.

Upstream: https://github.com/CachyOS/kernel-patches/blob/21d721415790e6717b2ece16e82e08eb98d16c00/7.3/misc/0001-handheld.patch

--- a/handheld.patch
+++ b/handheld.patch
@@ -16508,7 +16508,7 @@
  	ALC269VB_FIXUP_ORDISSIMO_EVE2,
  	ALC283_FIXUP_CHROME_BOOK,
 @@ -4399,6 +4416,30 @@ enum {
- 	ALC256_FIXUP_IPASON_SMARTBOOK_S1,
+ 	ALC245_FIXUP_MINISFORUM_V3_MIC_NO_PRESENCE,
  };
  
 +/* A special fixup for AYN and AYANEO handhelds as both
@@ -16568,9 +16568,9 @@
  		.type = HDA_FIXUP_PINS,
  		.v.pins = (const struct hda_pintbl[]) {
 @@ -8461,6 +8517,8 @@ static const struct hda_quirk alc269_fixup_tbl[] = {
- 	SND_PCI_QUIRK(0x1f4c, 0xb020, "Minisforum AI X1 Pro",
  		      ALC245_FIXUP_MINISFORUM_JACK_DETECT),
- 	SND_PCI_QUIRK(0x1f4c, 0xe001, "Minisforum V3 (SE)", ALC245_FIXUP_BASS_HP_DAC),
+ 	SND_PCI_QUIRK(0x1f4c, 0xe001, "Minisforum V3 (SE)",
+ 		      ALC245_FIXUP_MINISFORUM_V3_MIC_NO_PRESENCE),
 +	SND_PCI_QUIRK(0x1f66, 0x0101, "AYANEO 2/GEEK/Ayn MiniPro", ALC269_FIXUP_DMI_MATCH),
 +	SND_PCI_QUIRK(0x1f66, 0x0103, "AYANEO AIR 1S", ALC269VB_FIXUP_AYANEO_SPKR_PIN_FIX),
  	SND_PCI_QUIRK(0x1f66, 0x0105, "Ayaneo Portable Game Player", ALC287_FIXUP_CS35L41_I2C_2),
